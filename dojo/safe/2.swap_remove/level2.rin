// Level 2: every proc. The fields and the signatures are given; write the
// bodies. Each proc says what it must do; the harness checks how. The bodies
// here only return something, so the file compiles and the harness can tell
// you what is missing.
//
// Start it with: python tools/dojo.py start swap_remove 2

import "std/memops.rin"
import "std/vec.rin"
import "std/option.rin"
// The harness: it has main, and runs the procs below, so with it this file
// is a whole program.
import "harness.rin"

sparse_set: struct = {
    // Packed: values[row] belongs to ids[row]. No holes, in no order.
    values: *vec<u64> in level;
    ids: *vec<u32> in level;
    // Sparse: rows[id] is one more than the row id's value is in, so 0, what
    // a new entry starts as, means id has no value.
    rows: *vec<u32> in level;
}

sparse_set_make: proc(r: region level) -> *sparse_set in level = {
    return new<sparse_set>(r, { .values = vec<u64>make(r, 0), .ids = vec<u32>make(r, 0), .rows = vec<u32>make(r, 0) });
}

// id's value, to read or to change, or null if it has none.
sparse_set_get: proc(s: *sparse_set, id: u32) -> ?*u64 = {
    return null;
}

// Give id a value. If it has one already, the new value replaces it and the
// old one comes back; otherwise it goes in a new row at the end.
sparse_set_insert: proc(s: *sparse_set, id: u32, value: u64) -> option<u64> = {
    return option<u64>none();
}

// Take id's value out. The rows stay packed, and every id's row stays right.
sparse_set_remove: proc(s: *sparse_set, id: u32) -> option<u64> = {
    return option<u64>none();
}

// How many ids have a value.
sparse_set_len: proc(s: *sparse_set) -> u64 = {
    return 0;
}

// The values, packed, in row order.
sparse_set_values: proc(s: *sparse_set) -> []u64 = {
    return vec<u64>items(s*.values);
}

// ids[row] is the id that owns values[row].
sparse_set_ids: proc(s: *sparse_set) -> []u32 = {
    return vec<u32>items(s*.ids);
}
