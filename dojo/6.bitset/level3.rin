//   bitset_without: proc(set: u64, id: u32) -> u64
//   bitset_has: proc(set: u64, id: u32) -> b32
//   bitset_contains_all: proc(set: u64, wanted: u64) -> b32         every id of wanted is in set
//   bitset_intersects: proc(a: u64, b: u64) -> b32                  an id in both
//   bitset_matches: proc(set: u64, all: u64, none: u64) -> b32      all of all, none of none
//   bitset_count: proc(set: u64) -> u32
//   bitset_ids: proc(set: u64, out: []u32) -> u32                   smallest first, into out (room
//                                                                   for 64); returns how many

