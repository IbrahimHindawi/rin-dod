// Level 1: one proc. Everything here works except sparse_set_remove. Write its
// body.
//
// Start it with: python tools/dojo.py start swap_remove 1

sparse_set: struct = {
    arena: *memops_arena;
    // Packed: values[row] belongs to ids[row]. No holes, in no order.
    values: vec<u64>;
    ids: vec<u32>;
    // Sparse: rows[id] is one more than the row id's value is in, so 0, what
    // a new entry starts as, means id has no value.
    rows: vec<u32>;
}

sparse_set_init: proc(s: *sparse_set, arena: *memops_arena) -> void = {
    s* = {};
    s*.arena = arena;
}

// id's value, to read or to change, or null if it has none.
sparse_set_get: proc(s: *sparse_set, id: u32) -> *u64 = {
    if (cast(id, u64) >= s*.rows.length) {
        return null;
    }
    row: u32 = vec<u32>at(s*.rows&, cast(id, u64))*;
    if (row == 0) {
        return null;
    }
    return vec<u64>at(s*.values&, cast(row - 1, u64));
}

// Give id a value. If it has one already, the new value replaces it and the
// old one comes back; otherwise it goes in a new row at the end.
sparse_set_insert: proc(s: *sparse_set, id: u32, value: u64) -> option<u64> = {
    current: *u64 = sparse_set_get(s, id);
    if (current != null) {
        old: u64 = current*;
        current* = value;
        return option<u64>some(old);
    }
    while (s*.rows.length <= cast(id, u64)) {
        _ = vec<u32>append(s*.arena, s*.rows&, 0);
    }
    vec<u32>at(s*.rows&, cast(id, u64))* = cast(s*.values.length, u32) + 1;
    _ = vec<u64>append(s*.arena, s*.values&, value);
    _ = vec<u32>append(s*.arena, s*.ids&, id);
    return option<u64>none();
}

// Swap-remove: the last row moves into the hole, and the id that owned the
// last row is told where its value went.
sparse_set_remove: proc(s: *sparse_set, id: u32) -> option<u64> = {
    // Level 1: take id's value out, keeping the rows packed and every id's
    // row right. An id with no value gives none and changes nothing.
    return option<u64>none();
}

sparse_set_len: proc(s: *sparse_set) -> u64 = {
    return s*.values.length;
}

// The values, packed, in row order: what a system loops over.
sparse_set_values: proc(s: *sparse_set) -> []u64 = {
    return vec<u64>items(s*.values&);
}

// ids[row] is the id that owns values[row].
sparse_set_ids: proc(s: *sparse_set) -> []u32 = {
    return vec<u32>items(s*.ids&);
}
