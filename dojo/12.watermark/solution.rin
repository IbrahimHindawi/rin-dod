// The reference: a query that remembers how far down the list of tables it has
// looked, and looks only past that.

import "std/memops.rin"
import "std/vec.rin"
// The harness: it has main, and runs the procs below, so with it this file
// is a whole program.
import "harness.rin"

// Every bit of `all`, and none of `none`.
query_matches: proc(signature: u64, all: u64, none: u64) -> b32 = {
    return (signature & all) == all && (signature & none) == 0;
}

query: struct = {
    arena: *memops_arena;
    all: u64;
    none: u64;
    // The tables that match, by index, in the order they were found.
    tables: vec<u32>;
    // The watermark: tables 0 to checked - 1 have been looked at.
    checked: u64;
    // How many tables query_update has looked at, ever. With the watermark,
    // each table once.
    scanned: u64;
}

query_init: proc(q: *query, arena: *memops_arena, all: u64, none: u64) -> void = {
    q* = {};
    q*.arena = arena;
    q*.all = all;
    q*.none = none;
}

// Tables are only ever added, at the end, so the ones past the watermark are
// the only ones this query hasn't seen.
query_update: proc(q: *query, signatures: []u64) -> void = {
    for (ti: u64 = q*.checked; ti < signatures.length; ti += 1) {
        q*.scanned += 1;
        if (query_matches(signatures[ti], q*.all, q*.none)) {
            _ = vec<u32>append(q*.arena, q*.tables&, cast(ti, u32));
        }
    }
    q*.checked = signatures.length;
}

// The matching tables, in increasing order.
query_tables: proc(q: *query) -> []u32 = {
    return vec<u32>items(q*.tables&);
}

// How many tables the query has been updated over: the watermark.
query_checked: proc(q: *query) -> u64 = {
    return q*.checked;
}

// How many tables query_update has looked at, in all.
query_scanned: proc(q: *query) -> u64 = {
    return q*.scanned;
}
