// Level 1: the typed view. Everything here works except column_slice: turn the
// column's bytes into T's, refusing any T that can't be the column's type.
//
// Start it with: python tools/dojo.py start column 1

column: struct = {
    arena: *memops_arena;
    // `count` rows of `size` bytes each, packed from the start, in a block
    // from the arena aligned to `align`, with room for `capacity` rows.
    data: ^u8;
    size: u64;
    align: u64;
    count: u64;
    capacity: u64;
}

// An empty column of rows `size` bytes long, aligned to `align`. A column
// holds alignments 1 to 16 that are powers of two; anything else stops the
// program.
column_init: proc(c: *column, arena: *memops_arena, size: u64, align: u64) -> void = {
    if (align == 0 || align > 16 || (align & (align - 1)) != 0) {
        printfmt("column: a column holds alignments 1 to 16 that are powers of two, not {}\n", align);
        exit(1);
    }
    c* = {};
    c*.arena = arena;
    c*.size = size;
    c*.align = align;
}

column_len: proc(c: *column) -> u64 = {
    return c*.count;
}

// How many rows fit before the column has to grow.
column_capacity: proc(c: *column) -> u64 = {
    return c*.capacity;
}

// A new row at the end, zeroed; returns its row number. A full column doubles
// first: a new block from the arena, the rows copied into it. The old block
// stays in the arena, unused, and a slice taken before still points into it.
column_push_zeroed: proc(c: *column) -> u64 = {
    if (c*.count == c*.capacity) {
        capacity: u64 = c*.capacity == 0 ? 4 : c*.capacity * 2;
        data: ^u8 = cast(memops_arena_push_zero(c*.arena, c*.size * capacity, c*.align), ^u8);
        if (c*.count > 0) {
            memcpy(data, c*.data, c*.size * c*.count);
        }
        c*.data = data;
        c*.capacity = capacity;
    }
    row: u64 = c*.count;
    c*.count += 1;
    memset(c*.data[row * c*.size]&, 0, c*.size);
    return row;
}

// The last row's bytes move into `row`, and the column is one row shorter.
column_swap_remove: proc(c: *column, row: u64) -> void = {
    if (row >= c*.count) {
        printfmt("column: row {} is past the {} rows in use\n", row, c*.count);
        exit(1);
    }
    last: u64 = c*.count - 1;
    if (row != last) {
        memcpy(c*.data[row * c*.size]&, c*.data[last * c*.size]&, c*.size);
    }
    c*.count = last;
}

// One row's bytes. A row past the rows in use stops the program.
column_row: proc(c: *column, row: u64) -> []u8 = {
    if (row >= c*.count) {
        printfmt("column: row {} is past the {} rows in use\n", row, c*.count);
        exit(1);
    }
    return c*.data[row * c*.size..(row + 1) * c*.size];
}

// The rows in use as T's. Only a T of the column's size and alignment: the
// column can't know the type, but it can refuse every type that can't be the
// one it was made for.
column_slice: proc<T>(c: *column) -> []T = {
    // Level 1: the typed view. Turn the column's bytes into T's, and stop the
    // program, with a message, for any T that can't be the column's type.
    none: []T = {};
    return none;
}
