// Level 3: a blank page. Write the schedule from memory.
//
// Start it with: python tools/dojo.py start dispatch 3
//
// The harness needs exactly this, and checks what each does. It provides ctx,
// what a system is given when it runs, and vec<T>, option<T> and
// memops_arena are given:
//
//   system_proc: alias = *proc(c: *ctx) -> void           a system: a proc pointer
//   schedule: struct
//   schedule_init: proc(s: *schedule, arena: *memops_arena) -> void
//   schedule_add: proc(s: *schedule, name: ^const char, run: system_proc) -> void
//                                              at the end, enabled
//   schedule_insert_before: proc(s: *schedule, before: ^const char, name: ^const char,
//                                run: system_proc) -> b32
//                                              just before `before`, enabled; 0, and
//                                              nothing added, if it isn't there
//   schedule_remove: proc(s: *schedule, name: ^const char) -> b32
//                                              0 if it isn't there
//   schedule_set_enabled: proc(s: *schedule, name: ^const char, on: b32) -> b32
//                                              a disabled system keeps its place
//   schedule_run: proc(s: *schedule, c: *ctx) -> void
//                                              every enabled system, once, in order
//   schedule_len: proc(s: *schedule) -> u64    how many systems, enabled or not
//   schedule_name: proc(s: *schedule, i: u64) -> ^const char
//                                              the name of the i-th to run
//   schedule_calls: proc(s: *schedule, name: ^const char) -> u32
//                                              times schedule_run has called it since
//                                              it was added; 0 if it isn't there
//
// Names are C strings: compare them with strcmp.

import "std/memops.rin"
import "std/vec.rin"
import "std/option.rin"
import "std/cstd.rin"
// The harness: it has main, and runs the procs below, so with it this file
// is a whole program.
import "harness.rin"

// Your code here.
