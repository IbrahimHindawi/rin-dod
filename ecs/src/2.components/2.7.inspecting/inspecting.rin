// 2.7 Inspecting the world
//
// The world can store, copy and move any component, but it cannot show you
// one. When something goes wrong at frame 3,000 you want to see an entity:
// every component it has, every field, with names. In C that means writing a
// printer per component and keeping it in step with the struct. In rin the
// compiler already wrote down everything a printer needs: each component's
// reflect record lists its fields with their names, types and offsets. The
// world registered those records in 2.1 to know component sizes; here they
// pay off a second time.
//
//   kayan_inspect(w, e)       every component of e, field by field
//   kayan_print_layout(w)     every table, its columns, and their memory
//
// Neither names a single component type. Add a component tomorrow and both
// print it.

import "std/print.rin"
import "std/memops.rin"
import "std/vec.rin"
import "std/hashmap.rin"

vec2: struct = {
    x: f32;
    y: f32;
}

position: struct = { at: vec2; }
velocity: struct = { per_second: vec2; }
health: struct = { points: f32; max: f32; }
damage: struct = { amount: f32; }
lifetime: struct = { seconds: f32; }
// A field tagged "hidden" is bookkeeping the inspector does not show.
turret: struct = { cooldown: f32; timer: f32 @ "hidden"; }
burning: struct = { per_second: f32; }

component: enum = {
    position,
    velocity,
    health,
    damage,
    lifetime,
    turret,
    burning,
}

component_of: proc<position>() -> component = { return component.position; }
component_of: proc<velocity>() -> component = { return component.velocity; }
component_of: proc<health>() -> component = { return component.health; }
component_of: proc<damage>() -> component = { return component.damage; }
component_of: proc<lifetime>() -> component = { return component.lifetime; }
component_of: proc<turret>() -> component = { return component.turret; }
component_of: proc<burning>() -> component = { return component.burning; }

// ---------------------------------------------------------------------------
// Entities (Part 1)
// ---------------------------------------------------------------------------

kayan_entity: struct = {
    index: u32;
    generation: u32;
}

// `missing`: the entity is alive but has no such component.
kayan_status: enum[must_use] = {
    ok,
    dead,
    missing,
}

// Where an entity lives: which table, and which row of it.
kayan_slot: struct = {
    generation: u32;
    table: u32;
    row: u32;
}

// ---------------------------------------------------------------------------
// Columns (2.2)
// ---------------------------------------------------------------------------

kayan_column: struct = {
    data: ^u8;
    size: u64;
    align: u64;
}

kayan_column_init: proc(info: *const reflect) -> kayan_column = {
    c: kayan_column = {};
    c.size = info*.size;
    c.align = info*.align;
    return c;
}

kayan_column_row: proc(c: *kayan_column, row: u64) -> *u8 = {
    return c*.data[row * c*.size]&;
}

kayan_column_grow: proc(arena: *memops_arena, c: *kayan_column, count: u64, capacity: u64) -> void = {
    data: ^u8 = cast(memops_arena_push_zero(arena, c*.size * capacity, c*.align), ^u8);
    if (count > 0) {
        memcpy(data, c*.data, c*.size * count);
    }
    c*.data = data;
}

kayan_column_copy_row: proc(c: *kayan_column, to: u64, from: u64) -> void = {
    memcpy(kayan_column_row(c, to), kayan_column_row(c, from), c*.size);
}

kayan_column_zero_row: proc(c: *kayan_column, row: u64) -> void = {
    memset(kayan_column_row(c, row), 0, c*.size);
}

kayan_column_slice: proc<T>(c: *kayan_column, count: u64) -> []T = {
    if (c*.size != sizeof(T)) {
        printfmt("kayan: a column of {}-byte rows read as a {}-byte type\n", c*.size, sizeof(T));
        exit(1);
    }
    raw: ^T = cast(c*.data, ^T);
    return raw[0..count];
}

// ---------------------------------------------------------------------------
// The table
// ---------------------------------------------------------------------------

// `columns[id]` is in use when the signature has bit `id`; the others stay
// zeroed. Count and capacity are the table's, shared by its columns and by
// `entities`, so they can never disagree.
//
// The edges: `add_edges[id]` is the table this one's entities move to when
// they gain component `id`, and `remove_edges[id]` when they lose it. Each is
// the table's index plus one, so 0, which a new table starts with, means "not
// known yet".
kayan_table: struct = {
    signature: u64;
    count: u64;
    capacity: u64;
    entities: ^kayan_entity;
    columns: [64]kayan_column;
    add_edges: [64]u32;
    remove_edges: [64]u32;
}

// The world: the registry, the slots and free list, and every table, with a
// map from signature to table index so finding one is a lookup, not a search.
// Tables are referred to by index, never by pointer: making a table can grow
// `tables` and move all of them, and an index survives that.
kayan_world: struct = {
    arena: *memops_arena;
    infos: [64]*const reflect;
    component_count: u32;
    tables: vec<kayan_table>;
    by_signature: hashmap<u64, u32>;
    slots: vec<kayan_slot>;
    free: vec<u32>;
    live: u64;
    // How table moves found their destination, for this chapter's output.
    lookups: u64;
    edge_hits: u64;
}

kayan_bit: proc(id: u32) -> u64 = {
    return 1'u64 shl cast(id, u64);
}

kayan_id_of: proc<T>() -> u32 = {
    return cast(component_of<T>(), u32);
}

kayan_mask_of: proc<T>() -> u64 = {
    return kayan_bit(kayan_id_of<T>());
}

kayan_register: proc(w: *kayan_world, id: u32, info: *const reflect) -> void = {
    if (id >= 64) {
        printfmt("kayan: component id {} is past the 64 a signature can hold\n", id);
        exit(1);
    }
    w*.infos[id] = info;
    if (id + 1 > w*.component_count) {
        w*.component_count = id + 1;
    }
}

kayan_table_has: proc(t: *kayan_table, id: u32) -> b32 = {
    return (t*.signature & kayan_bit(id)) != 0;
}

// A table for a signature: one empty column per component in it, sized from
// the registry. Every component in the signature must be registered.
kayan_table_init: proc(w: *kayan_world, signature: u64) -> kayan_table = {
    t: kayan_table = {};
    t.signature = signature;
    for (id: u32 = 0; id < 64; id += 1) {
        if ((signature & kayan_bit(id)) != 0) {
            if (id >= w*.component_count || w*.infos[id] == null) {
                printfmt("kayan: signature {} uses component {}, which was never registered\n", signature, id);
                exit(1);
            }
            t.columns[id] = kayan_column_init(w*.infos[id]);
        }
    }
    return t;
}

// Double the room in `entities` and in every column at once.
kayan_table_grow: proc(w: *kayan_world, t: *kayan_table) -> void = {
    capacity: u64 = t*.capacity == 0 ? 4 : t*.capacity * 2;
    entities: ^kayan_entity = cast(memops_arena_push_zero(w*.arena,
        sizeof(kayan_entity) * capacity, alignof(kayan_entity)), ^kayan_entity);
    if (t*.count > 0) {
        memcpy(entities, t*.entities, sizeof(kayan_entity) * t*.count);
    }
    t*.entities = entities;
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if (kayan_table_has(t, id)) {
            kayan_column_grow(w*.arena, t*.columns[id]&, t*.count, capacity);
        }
    }
    t*.capacity = capacity;
}

// A new row at the end, owned by `e`, with every component zeroed.
kayan_table_add_row: proc(w: *kayan_world, t: *kayan_table, e: kayan_entity) -> u64 = {
    if (t*.count == t*.capacity) {
        kayan_table_grow(w, t);
    }
    row: u64 = t*.count;
    t*.count += 1;
    t*.entities[row] = e;
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if (kayan_table_has(t, id)) {
            kayan_column_zero_row(t*.columns[id]&, row);
        }
    }
    return row;
}

// 1.4's swap-remove, for every column: the last row is copied over `row`, and
// the slot of the entity that owned the last row is told where it went.
kayan_table_remove_row: proc(w: *kayan_world, t: *kayan_table, row: u64) -> void = {
    last: u64 = t*.count - 1;
    if (row != last) {
        for (id: u32 = 0; id < w*.component_count; id += 1) {
            if (kayan_table_has(t, id)) {
                kayan_column_copy_row(t*.columns[id]&, row, last);
            }
        }
        moved: kayan_entity = t*.entities[last];
        t*.entities[row] = moved;
        vec<kayan_slot>at(w*.slots&, cast(moved.index, u64))*.row = cast(row, u32);
    }
    t*.count = last;
}

// The typed view of one of the table's columns: T's rows, all of them in use.
// Asking for a component the table does not have is a bug, so it stops.
kayan_slice: proc<T>(t: *kayan_table) -> []T = {
    id: u32 = kayan_id_of<T>();
    if (!kayan_table_has(t, id)) {
        printfmt("kayan: the table has no column for component {}\n", id);
        exit(1);
    }
    return kayan_column_slice<T>(t*.columns[id]&, t*.count);
}

// A pointer to a table is good until the next table is made.
kayan_table_at: proc(w: *kayan_world, index: u32) -> *kayan_table = {
    return vec<kayan_table>at(w*.tables&, cast(index, u64));
}

// The table for a signature: found if it exists, made if it does not. This is
// where archetypes come from.
kayan_table_for: proc(w: *kayan_world, signature: u64) -> u32 = {
    found: *u32 = hashmap<u64, u32>get(w*.by_signature&, signature);
    if (found != null) {
        return found*;
    }
    index: u32 = cast(w*.tables.length, u32);
    _ = vec<kayan_table>append(w*.arena, w*.tables&, kayan_table_init(w, signature));
    _ = hashmap<u64, u32>put(w*.arena, w*.by_signature&, signature, index);
    return index;
}

// ---------------------------------------------------------------------------
// The world
// ---------------------------------------------------------------------------

kayan_world_init: proc(w: *kayan_world, arena: *memops_arena) -> void = {
    w* = {};
    w*.arena = arena;
}

kayan_alive: proc(w: *kayan_world, e: kayan_entity) -> b32 = {
    if (cast(e.index, u64) >= w*.slots.length) {
        return false;
    }
    return vec<kayan_slot>at(w*.slots&, cast(e.index, u64))*.generation == e.generation;
}

// A new entity with the components in `signature`, all zeroed, in the table
// for that signature.
kayan_spawn: proc(w: *kayan_world, signature: u64) -> kayan_entity = {
    e: kayan_entity = {};
    if (!vec<u32>is_empty(w*.free&)) {
        e.index = vec<u32>pop(w*.free&);
    } else {
        e.index = cast(w*.slots.length, u32);
        _ = vec<kayan_slot>append(w*.arena, w*.slots&, { .generation = 1 });
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots&, cast(e.index, u64));
    e.generation = slot*.generation;
    // kayan_table_for can make a table and move the others, so the table's
    // pointer is taken after it.
    table_index: u32 = kayan_table_for(w, signature);
    t: *kayan_table = kayan_table_at(w, table_index);
    slot*.table = table_index;
    slot*.row = cast(kayan_table_add_row(w, t, e), u32);
    w*.live += 1;
    return e;
}

kayan_despawn: proc(w: *kayan_world, e: kayan_entity) -> kayan_status = {
    if (!kayan_alive(w, e)) {
        return kayan_status.dead;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots&, cast(e.index, u64));
    kayan_table_remove_row(w, kayan_table_at(w, slot*.table), cast(slot*.row, u64));
    slot*.generation += 1;
    _ = vec<u32>append(w*.arena, w*.free&, e.index);
    w*.live -= 1;
    return kayan_status.ok;
}

// The components a live entity has: its table's signature. 0 for a dead one.
kayan_signature: proc(w: *kayan_world, e: kayan_entity) -> u64 = {
    if (!kayan_alive(w, e)) {
        return 0;
    }
    return kayan_table_at(w, vec<kayan_slot>at(w*.slots&, cast(e.index, u64))*.table)*.signature;
}

// ---------------------------------------------------------------------------
// Moving between tables
// ---------------------------------------------------------------------------

// The table an entity of table `from` moves to when it gains component `id`.
// The first time, it is found by signature, which can make the table; the
// answer is written on both tables, as from's add edge and the destination's
// remove edge, so neither direction is looked up again.
kayan_table_with: proc(w: *kayan_world, from: u32, id: u32) -> u32 = {
    edge: u32 = kayan_table_at(w, from)*.add_edges[id];
    if (edge != 0) {
        w*.edge_hits += 1;
        return edge - 1;
    }
    w*.lookups += 1;
    to: u32 = kayan_table_for(w, kayan_table_at(w, from)*.signature | kayan_bit(id));
    // kayan_table_for can move the tables, so both pointers are taken after it.
    kayan_table_at(w, from)*.add_edges[id] = to + 1;
    kayan_table_at(w, to)*.remove_edges[id] = from + 1;
    return to;
}

// The same for losing component `id`.
kayan_table_without: proc(w: *kayan_world, from: u32, id: u32) -> u32 = {
    edge: u32 = kayan_table_at(w, from)*.remove_edges[id];
    if (edge != 0) {
        w*.edge_hits += 1;
        return edge - 1;
    }
    w*.lookups += 1;
    to: u32 = kayan_table_for(w, kayan_table_at(w, from)*.signature & ~kayan_bit(id));
    kayan_table_at(w, from)*.remove_edges[id] = to + 1;
    kayan_table_at(w, to)*.add_edges[id] = from + 1;
    return to;
}

// Move a live entity to table `to_index`. Components both tables have are
// copied, byte for byte; components only the new table has start zeroed;
// components only the old table has are dropped with its old row.
kayan_move: proc(w: *kayan_world, e: kayan_entity, to_index: u32) -> void = {
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots&, cast(e.index, u64));
    from_index: u32 = slot*.table;
    if (from_index == to_index) {
        return;
    }
    from: *kayan_table = kayan_table_at(w, from_index);
    to: *kayan_table = kayan_table_at(w, to_index);
    from_row: u64 = cast(slot*.row, u64);
    to_row: u64 = kayan_table_add_row(w, to, e);
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if (kayan_table_has(from, id) && kayan_table_has(to, id)) {
            memcpy(kayan_column_row(to*.columns[id]&, to_row),
                kayan_column_row(from*.columns[id]&, from_row), from*.columns[id].size);
        }
    }
    kayan_table_remove_row(w, from, from_row);
    slot*.table = to_index;
    slot*.row = cast(to_row, u32);
}

// ---------------------------------------------------------------------------
// The byte layer, for tools
// ---------------------------------------------------------------------------

// e's component `id` as its bytes: an empty slice if e is dead or has no such
// component. The typed layer is for game code, which knows its types; this is
// for tools that work from reflect records instead.
kayan_get_bytes: proc(w: *kayan_world, e: kayan_entity, id: u32) -> []u8 = {
    none: []u8 = {};
    if (!kayan_alive(w, e) || id >= w*.component_count) {
        return none;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots&, cast(e.index, u64));
    t: *kayan_table = kayan_table_at(w, slot*.table);
    if (!kayan_table_has(t, id)) {
        return none;
    }
    c: *kayan_column = t*.columns[id]&;
    row: u64 = cast(slot*.row, u64);
    all: []u8 = c*.data[0..t*.count * c*.size];
    return all[row * c*.size..(row + 1) * c*.size];
}

// ---------------------------------------------------------------------------
// The typed layer
// ---------------------------------------------------------------------------

// e's T, or null if e is dead or has no T. Handle, slot, table, row, typed
// view: the same path as 1.4's get_position, for any component. The pointer is
// good until the next structural change, so use it now and keep the handle.
kayan_get: proc<T>(w: *kayan_world, e: kayan_entity) -> *T = {
    if (!kayan_alive(w, e)) {
        return null;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots&, cast(e.index, u64));
    t: *kayan_table = kayan_table_at(w, slot*.table);
    if (!kayan_table_has(t, kayan_id_of<T>())) {
        return null;
    }
    rows: []T = kayan_slice<T>(t);
    return rows[cast(slot*.row, u64)]&;
}

kayan_has: proc<T>(w: *kayan_world, e: kayan_entity) -> b32 = {
    return (kayan_signature(w, e) & kayan_mask_of<T>()) != 0;
}

// Write e's T. It must already have one: giving an entity a component it does
// not have changes its table, which is 2.6.
kayan_set: proc<T>(w: *kayan_world, e: kayan_entity, value: T) -> kayan_status = {
    if (!kayan_alive(w, e)) {
        return kayan_status.dead;
    }
    p: *T = kayan_get<T>(w, e);
    if (p == null) {
        return kayan_status.missing;
    }
    p* = value;
    return kayan_status.ok;
}

// Give e a T. If it already has one, this is kayan_set; if not, it moves to
// the table with T and then sets it.
kayan_add: proc<T>(w: *kayan_world, e: kayan_entity, value: T) -> kayan_status = {
    if (!kayan_alive(w, e)) {
        return kayan_status.dead;
    }
    if (!kayan_has<T>(w, e)) {
        from: u32 = vec<kayan_slot>at(w*.slots&, cast(e.index, u64))*.table;
        kayan_move(w, e, kayan_table_with(w, from, kayan_id_of<T>()));
    }
    return kayan_set<T>(w, e, value);
}

// Take e's T away, moving it to the table without T.
kayan_remove: proc<T>(w: *kayan_world, e: kayan_entity) -> kayan_status = {
    if (!kayan_alive(w, e)) {
        return kayan_status.dead;
    }
    if (!kayan_has<T>(w, e)) {
        return kayan_status.missing;
    }
    from: u32 = vec<kayan_slot>at(w*.slots&, cast(e.index, u64))*.table;
    kayan_move(w, e, kayan_table_without(w, from, kayan_id_of<T>()));
    return kayan_status.ok;
}

// The invariant, over every table: each row belongs to a live entity whose
// slot points back at that table and row, and the rows of all tables add up to
// the live count.
kayan_verify: proc(w: *kayan_world) -> u64 = {
    problems: u64 = 0;
    rows: u64 = 0;
    for (ti: u64 = 0; ti < w*.tables.length; ti += 1) {
        t: *kayan_table = kayan_table_at(w, cast(ti, u32));
        for (row: u64 = 0; row < t*.count; row += 1) {
            e: kayan_entity = t*.entities[row];
            if (!kayan_alive(w, e)) {
                printfmt("kayan_verify: table {} row {} holds dead entity {}:{}\n", ti, row, e.index, e.generation);
                problems += 1;
                continue;
            }
            slot: *kayan_slot = vec<kayan_slot>at(w*.slots&, cast(e.index, u64));
            if (cast(slot*.table, u64) != ti || cast(slot*.row, u64) != row) {
                printfmt("kayan_verify: {}:{} is in table {} row {}, its slot says table {} row {}\n",
                    e.index, e.generation, ti, row, slot*.table, slot*.row);
                problems += 1;
            }
        }
        rows += t*.count;
    }
    if (rows != w*.live) {
        printfmt("kayan_verify: {} rows in tables, {} live entities\n", rows, w*.live);
        problems += 1;
    }
    return problems;
}

kayan_print_signature: proc(w: *kayan_world, signature: u64) -> void = {
    printf("{");
    first: b32 = true;
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if ((signature & kayan_bit(id)) != 0) {
            printf(first ? "%s" : " %s", w*.infos[id]*.name);
            first = false;
        }
    }
    printf("}");
}

kayan_print_tables: proc(w: *kayan_world) -> void = {
    for (ti: u64 = 0; ti < w*.tables.length; ti += 1) {
        t: *kayan_table = kayan_table_at(w, cast(ti, u32));
        printf("    table %u ", cast(ti, u32));
        kayan_print_signature(w, t*.signature);
        printf(":");
        for (row: u64 = 0; row < t*.count; row += 1) {
            printf(" %u:%u", t*.entities[row].index, t*.entities[row].generation);
        }
        printf("\n");
    }
}

// ---------------------------------------------------------------------------
// The inspector: reflect records, no component types
// ---------------------------------------------------------------------------

kayan_indent: proc(depth: u32) -> void = {
    for (i: u32 = 0; i < depth; i += 1) {
        printf("    ");
    }
}

// One value of a builtin type, read from its bytes by its type's name.
kayan_print_builtin: proc(type_name: ^const char, at: []const u8) -> void = {
    if (strcmp(type_name, "f32") == 0) {
        printf("%.2f", cast(cast(at[0]&, *const f32)*, f64));
    } else if (strcmp(type_name, "u32") == 0) {
        printf("%u", cast(at[0]&, *const u32)*);
    } else if (strcmp(type_name, "i32") == 0) {
        printf("%d", cast(at[0]&, *const i32)*);
    } else {
        printf("<%s>", type_name);
    }
}

// Every field of a struct whose bytes are `base`, nested structs indented
// under their field. A field's bytes are cut from `base` by its offset and
// size, both from the reflect record.
kayan_print_fields: proc(type: *const reflect, base: []const u8, depth: u32) -> void = {
    fields: ^const reflect_field = reflect_fields(type);
    for (i: u64 = 0; i < type*.count; i += 1) {
        f: *const reflect_field = fields[i]&;
        if (reflect_field_has_attr(f, "hidden")) {
            continue;
        }
        at: []const u8 = base[f*.offset..f*.offset + f*.size];
        kayan_indent(depth);
        printf("%s:", f*.name);
        info: *const reflect = f*.info;
        if (info != null && info*.kind == reflect_kind_struct) {
            printf("\n");
            kayan_print_fields(info, at, depth + 1);
        } else {
            printf(" ");
            kayan_print_builtin(f*.type, at);
            printf("\n");
        }
    }
}

kayan_inspect: proc(w: *kayan_world, e: kayan_entity) -> void = {
    if (!kayan_alive(w, e)) {
        printfmt("{}:{} (dead)\n", e.index, e.generation);
        return;
    }
    printf("%u:%u ", e.index, e.generation);
    signature: u64 = kayan_signature(w, e);
    kayan_print_signature(w, signature);
    printf("\n");
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if ((signature & kayan_bit(id)) != 0) {
            info: *const reflect = w*.infos[id];
            printf("    %s\n", info*.name);
            bytes: []u8 = kayan_get_bytes(w, e, id);
            kayan_print_fields(info, bytes, 2);
        }
    }
}

// Every table: rows in use out of room, and per column its row size and its
// bytes in use out of bytes allocated. The memory a table holds and does not
// use is the cost of doubling on growth.
kayan_print_layout: proc(w: *kayan_world) -> void = {
    for (ti: u32 = 0; ti < cast(w*.tables.length, u32); ti += 1) {
        t: *kayan_table = kayan_table_at(w, ti);
        printf("table %u ", ti);
        kayan_print_signature(w, t*.signature);
        printf(": %u rows, room for %u\n", cast(t*.count, u32), cast(t*.capacity, u32));
        for (id: u32 = 0; id < w*.component_count; id += 1) {
            if (kayan_table_has(t, id)) {
                size: u64 = t*.columns[id].size;
                printf("    %-9s %2u bytes a row, %4u of %4u bytes in use\n", w*.infos[id]*.name, cast(size, u32),
                    cast(size * t*.count, u32), cast(size * t*.capacity, u32));
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The program
// ---------------------------------------------------------------------------

spawn_drone: proc(w: *kayan_world, x: f32, y: f32) -> kayan_entity = {
    e: kayan_entity = kayan_spawn(w, kayan_mask_of<position>() | kayan_mask_of<velocity>() | kayan_mask_of<health>());
    _ = kayan_set<position>(w, e, { .at = { .x = x, .y = y } });
    _ = kayan_set<velocity>(w, e, { .per_second = { .x = -1.0, .y = 0.0 } });
    _ = kayan_set<health>(w, e, { .points = 100.0, .max = 100.0 });
    return e;
}

main: proc() -> i32 = {
    arena: memops_arena = {};
    memops_arena_initialize(arena&);
    w: kayan_world = {};
    kayan_world_init(w&, arena&);
    kayan_register(w&, kayan_id_of<position>(), position<>&);
    kayan_register(w&, kayan_id_of<velocity>(), velocity<>&);
    kayan_register(w&, kayan_id_of<health>(), health<>&);
    kayan_register(w&, kayan_id_of<damage>(), damage<>&);
    kayan_register(w&, kayan_id_of<lifetime>(), lifetime<>&);
    kayan_register(w&, kayan_id_of<turret>(), turret<>&);
    kayan_register(w&, kayan_id_of<burning>(), burning<>&);

    gun: kayan_entity = kayan_spawn(w&, kayan_mask_of<position>() | kayan_mask_of<turret>());
    _ = kayan_set<turret>(w&, gun, { .cooldown = 0.5, .timer = 0.25 });
    a: kayan_entity = spawn_drone(w&, 20.0, 5.0);
    b: kayan_entity = spawn_drone(w&, 30.0, -5.0);
    _ = kayan_add<burning>(w&, b, { .per_second = 10.0 });
    h: *health = kayan_get<health>(w&, b);
    h*.points = 60.0;
    shot: kayan_entity = kayan_spawn(w&, kayan_mask_of<position>() | kayan_mask_of<velocity>()
        | kayan_mask_of<damage>() | kayan_mask_of<lifetime>());
    _ = kayan_set<velocity>(w&, shot, { .per_second = { .x = 8.0, .y = 0.0 } });
    _ = kayan_set<damage>(w&, shot, { .amount = 25.0 });
    _ = kayan_set<lifetime>(w&, shot, { .seconds = 2.0 });

    kayan_inspect(w&, gun);
    kayan_inspect(w&, a);
    kayan_inspect(w&, b);
    kayan_inspect(w&, shot);
    _ = kayan_despawn(w&, a);
    kayan_inspect(w&, a);
    printfmt("\n");
    kayan_print_layout(w&);
    printfmt("kayan_verify: {} problems\n", kayan_verify(w&));
    return 0;
}
