// kayan: archetype tables, entity handles, and moving entities between tables.
//
// This is the world lesson 4 builds, kept as a library so lessons 5 and 6 can
// use it as it is. Read it with lesson 4: the lesson explains the why, this
// file is the how.
//
// What a program using it provides:
//
//   * its components, as structs, and an enum with one member per component;
//   * `component_of: proc<T>() -> <its enum>` for each component type, which
//     the generic procs here call to find a type's id;
//   * a call to `kayan_register` for each component, with its reflect record.
//
// Ids are u32 here, so the library does not need to know the program's enum.
// Up to 64 components, because a signature is a u64.
//
// Not here, on purpose: threads, change tracking, chunked storage, relations.
// Each is worth a lesson of its own and none is needed to see the idea.
//
// Safe subset. A table's columns are raw bytes addressed by a component's size
// and alignment, which is the one thing rin's checker cannot type, so this
// library is the trusted core of lessons 4, 5 and 6: the procs that allocate,
// copy and reinterpret those bytes are marked [trusted], and their signatures
// are the promise the lessons build on. What a lesson can hold is said in the
// types: `?*T` where null is possible, `*const` where nothing is written, a
// `[]T` cut to the rows in use. Everything that can be written in terms of
// those promises (add, remove, set, verify, printing) is checked.
//
// The world lives in the region `level`, declared here for every program that
// imports this file; lesson 6 also uses `frame`, one region per game frame.

import "std/print.rin"
import "std/memops.rin"
import "std/vec.rin"
import "std/hashmap.rin"

level: region;
frame: region in level;

// A handle. `index` picks a slot in the world's slot list and `generation` says
// which life of that slot the handle was made for. Despawning bumps the slot's
// generation, so every handle to the dead entity stops matching, even after the
// index is reused. Generations start at 1, so a zeroed handle, `{}`, never
// names a live entity and can stand for "none".
kayan_entity: struct = {
    index: u32;
    generation: u32;
}

// Where an entity lives now: which table, which row. Rows move (swap-remove,
// lesson 2), so this is updated whenever one does. Handles never move. A free
// slot already holds its next generation, which no handle has yet, so the
// generation check alone says whether a handle is alive.
kayan_slot: struct = {
    generation: u32;
    table: u32;
    row: u32;
}

// One archetype. `entities[row]` is the handle of the entity in that row, which
// is how a swap-remove finds the slot to fix. `columns[id]` is null unless the
// signature has bit `id`.
kayan_table: struct = {
    signature: u64;
    count: u64;
    capacity: u64;
    entities: ^kayan_entity;
    columns: [64]^u8;
}

kayan_query: struct = {
    all: u64;
    none: u64;
}

// What a structural change reports. `dead` means the handle no longer names a
// live entity, so nothing was changed.
kayan_status: enum[must_use] = {
    ok,
    dead,
}

kayan_world: struct = {
    // The region's arena, kept so the trusted procs can grow columns without
    // being handed the region each call; set by kayan_world_make.
    arena: ^memops_arena;
    // Reflect records are globals, so they live in `permanent`; null until
    // the component is registered.
    infos: [64]?*const reflect in permanent;
    component_count: u32;
    // Tables are referred to by index. A pointer from kayan_table_at is good
    // until the next table is created, which can move the list; the checker
    // knows this and makes the caller take it again after any call that may.
    tables: *vec<kayan_table> in level;
    by_signature: *hashmap<u64, u32> in level;
    slots: *vec<kayan_slot> in level;
    free: *vec<u32> in level;
    live: u64;
}

// ---------------------------------------------------------------------------
// Components
// ---------------------------------------------------------------------------

kayan_bit: proc(id: u32) -> u64 = {
    return 1'u64 shl cast(id, u64);
}

kayan_id_of: proc<T>() -> u32 = {
    return cast(component_of<T>(), u32);
}

kayan_mask_of: proc<T>() -> u64 = {
    return kayan_bit(kayan_id_of<T>());
}

// The world and its lists, in the region. Trusted: the world holds raw
// pointers (the tables' columns), and such a value is only made by a proc
// that vouches for it.
kayan_world_make: proc[trusted](r: region level) -> *kayan_world in level = {
    w: *kayan_world in level = new<kayan_world>(r, {
        .tables = vec<kayan_table>make(r, 8),
        .by_signature = hashmap<u64, u32>make(r),
        .slots = vec<kayan_slot>make(r, 64),
        .free = vec<u32>make(r, 16),
    });
    w*.arena = r;
    return w;
}

// Trusted: writes a field of the world, which the checker reserves for the
// struct's own procs.
kayan_register: proc[trusted](w: *kayan_world, id: u32, info: *const reflect in permanent) -> void = {
    if (id >= 64) {
        printfmt("kayan: component id {} is past the 64 a signature can hold\n", id);
        exit(1);
    }
    w*.infos[id] = info;
    if (id + 1 > w*.component_count) {
        w*.component_count = id + 1;
    }
}

// The reflect record of a registered component. Stops the program for an id
// that was never registered, so callers get a `*const`, not a `?*const`.
kayan_info: proc(w: *const kayan_world, id: u32) -> *const reflect in permanent = {
    info: ?*const reflect in permanent = w*.infos[id];
    if (!info) {
        printfmt("kayan: component {} was never registered\n", id);
        exit(1);
    }
    return info;
}

kayan_component_name: proc(w: *const kayan_world, id: u32) -> ^const char = {
    return kayan_info(w, id)*.name;
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

// Borrowed from the table list: good until the next kayan_table_for or spawn.
// Trusted for its `*const` promise: it reads the world and moves nothing.
kayan_table_at: proc(w: *const kayan_world, index: u32) -> *kayan_table = {
    return vec<kayan_table>at(w*.tables, cast(index, u64));
}

// Double the table's columns. The old columns stay in the arena unused: an
// arena does not free single allocations, and these lessons accept the waste.
// Trusted: raw pushes with the component's alignment, and memcpy.
kayan_table_grow: proc[trusted](w: *kayan_world, t: *kayan_table) -> void = {
    capacity: u64 = t*.capacity == 0 ? 16 : t*.capacity * 2;
    entities: ^kayan_entity = cast(memops_arena_push_zero(w*.arena[0]&,
        sizeof(kayan_entity) * capacity, alignof(kayan_entity)), ^kayan_entity);
    if (t*.count > 0) {
        memcpy(entities, t*.entities, sizeof(kayan_entity) * t*.count);
    }
    t*.entities = entities;
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if ((t*.signature & kayan_bit(id)) != 0) {
            info: *const reflect = kayan_info(w, id);
            column: ^u8 = cast(memops_arena_push_zero(w*.arena[0]&, info*.size * capacity,
                info*.align), ^u8);
            if (t*.count > 0) {
                memcpy(column, t*.columns[id], info*.size * t*.count);
            }
            t*.columns[id] = column;
        }
    }
    t*.capacity = capacity;
}

// The table for a signature, made the first time anything needs it. Trusted:
// it appends to the table list and writes the world's map.
kayan_table_for: proc[trusted](w: *kayan_world, signature: u64) -> u32 = {
    found: ?*u32 = hashmap<u64, u32>get(w*.by_signature, signature);
    if (found) {
        return found*;
    }
    for (id: u32 = 0; id < 64; id += 1) {
        if ((signature & kayan_bit(id)) != 0 && (id >= w*.component_count || w*.infos[id] == null)) {
            printfmt("kayan: signature {} uses component {}, which was never registered\n", signature, id);
            exit(1);
        }
    }
    t: kayan_table = {};
    t.signature = signature;
    index: u32 = cast(w*.tables*.length, u32);
    _ = vec<kayan_table>push(w*.tables, t);
    _ = hashmap<u64, u32>set(w*.by_signature, signature, index);
    return index;
}

// A new row with zeroed components, owned by `e`. Trusted: memset of raw bytes.
kayan_table_add_row: proc[trusted](w: *kayan_world, t: *kayan_table, e: kayan_entity) -> u64 = {
    if (t*.count == t*.capacity) {
        kayan_table_grow(w, t);
    }
    row: u64 = t*.count;
    t*.entities[row] = e;
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if (t*.columns[id] != null) {
            size: u64 = kayan_info(w, id)*.size;
            memset(t*.columns[id][row * size]&, 0, size);
        }
    }
    t*.count += 1;
    return row;
}

// Swap-remove: the last row moves into `row`, and the slot of the entity that
// moved is told its new row. This is the line lesson 2 could not write.
// Trusted: memcpy of raw bytes.
kayan_table_remove_row: proc[trusted](w: *kayan_world, t: *kayan_table, row: u64) -> void = {
    last: u64 = t*.count - 1;
    if (row != last) {
        for (id: u32 = 0; id < w*.component_count; id += 1) {
            if (t*.columns[id] != null) {
                size: u64 = kayan_info(w, id)*.size;
                memcpy(t*.columns[id][row * size]&, t*.columns[id][last * size]&, size);
            }
        }
        moved: kayan_entity = t*.entities[last];
        t*.entities[row] = moved;
        vec<kayan_slot>at(w*.slots, cast(moved.index, u64))*.row = cast(row, u32);
    }
    t*.count = last;
}

// Trusted only for the `*const` promise: a checked proc taking a pointer to a
// table would be assumed able to move its rows, and every column slice the
// caller holds would have to be taken again after the call.
kayan_matches: proc(t: *const kayan_table, q: kayan_query) -> b32 = {
    return (t*.signature & q.all) == q.all && (t*.signature & q.none) == 0;
}

// T's column, cut to the rows in use. Asking for a column the table does not
// have is a bug in the caller, so it stops the program. Trusted: the cast from
// bytes to T. The slice is a borrow of the table, good until a row is added or
// removed; the checker enforces that at the caller.
kayan_column: proc[trusted]<T>(t: *const kayan_table) -> []T = {
    id: u32 = kayan_id_of<T>();
    if (t*.columns[id] == null) {
        printfmt("kayan: table {} has no column for component {}\n", t*.signature, id);
        exit(1);
    }
    raw: ^T = cast(t*.columns[id], ^T);
    return raw[0..t*.count];
}

// Trusted: a slice over the raw entities column.
kayan_table_entities: proc[trusted](t: *const kayan_table) -> []kayan_entity = {
    return t*.entities[0..t*.count];
}

// ---------------------------------------------------------------------------
// Entities
// ---------------------------------------------------------------------------

// Trusted for the `*const` promise, as kayan_matches is.
kayan_alive: proc(w: *const kayan_world, e: kayan_entity) -> b32 = {
    if (cast(e.index, u64) >= w*.slots*.length) {
        return 0;
    }
    return vec<kayan_slot>at(w*.slots, cast(e.index, u64))*.generation == e.generation;
}

// A new entity with the components in `signature`, all zeroed. A freed index is
// reused before a new one is made, with the generation its despawn left behind.
// Trusted: it writes the world's live count and may grow a table, which moves
// columns; the signature says so by taking `*kayan_world`, so the caller's
// column slices are dead after it.
kayan_spawn: proc[trusted](w: *kayan_world, signature: u64) -> kayan_entity = {
    e: kayan_entity = {};
    if (!vec<u32>is_empty(w*.free)) {
        e.index = vec<u32>pop(w*.free);
    } else {
        e.index = cast(w*.slots*.length, u32);
        _ = vec<kayan_slot>push(w*.slots, { .generation = 1 });
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
    e.generation = slot*.generation;

    table_index: u32 = kayan_table_for(w, signature);
    t: *kayan_table = kayan_table_at(w, table_index);
    row: u64 = kayan_table_add_row(w, t, e);

    slot*.table = table_index;
    slot*.row = cast(row, u32);
    w*.live += 1;
    return e;
}

// A dead handle reports `dead`, so despawning twice is harmless. Trusted: it
// removes a row and writes the live count.
kayan_despawn: proc[trusted](w: *kayan_world, e: kayan_entity) -> kayan_status = {
    if (!kayan_alive(w, e)) {
        return kayan_status.dead;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
    kayan_table_remove_row(w, kayan_table_at(w, slot*.table), cast(slot*.row, u64));
    slot*.generation += 1;
    _ = vec<u32>push(w*.free, e.index);
    w*.live -= 1;
    return kayan_status.ok;
}

kayan_signature: proc(w: *const kayan_world, e: kayan_entity) -> u64 = {
    if (!kayan_alive(w, e)) {
        return 0;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
    return kayan_table_at(w, slot*.table)*.signature;
}

// Move `e` to the table for `signature`. Components both tables have are
// copied; components only the new table has start zeroed; components only the
// old table has are dropped. Trusted: memcpy between columns.
kayan_move: proc[trusted](w: *kayan_world, e: kayan_entity, signature: u64) -> kayan_status = {
    if (!kayan_alive(w, e)) {
        return kayan_status.dead;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
    from_index: u32 = slot*.table;
    if (kayan_table_at(w, from_index)*.signature == signature) {
        return kayan_status.ok;
    }
    // kayan_table_for may add a table, so the table pointers are taken after it.
    to_index: u32 = kayan_table_for(w, signature);
    from: *kayan_table = kayan_table_at(w, from_index);
    to: *kayan_table = kayan_table_at(w, to_index);
    from_row: u64 = cast(slot*.row, u64);
    to_row: u64 = kayan_table_add_row(w, to, e);
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if (from*.columns[id] != null && to*.columns[id] != null) {
            size: u64 = kayan_info(w, id)*.size;
            memcpy(to*.columns[id][to_row * size]&, from*.columns[id][from_row * size]&, size);
        }
    }
    kayan_table_remove_row(w, from, from_row);
    slot*.table = to_index;
    slot*.row = cast(to_row, u32);
    return kayan_status.ok;
}

// e's T, or null if e is dead or has no T: a `?*T`, so the caller tests it.
// The row is checked against the rows in use, so a slot pointing past the end
// stops the program in Debug. The pointer is a borrow of the world: good until
// the next spawn, despawn, add or remove.
kayan_get: proc<T>(w: *const kayan_world, e: kayan_entity) -> ?*T = {
    if (!kayan_alive(w, e)) {
        return null;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
    t: *kayan_table = kayan_table_at(w, slot*.table);
    if (t*.columns[kayan_id_of<T>()] == null) {
        return null;
    }
    rows: []T = kayan_column<T>(t);
    return rows[cast(slot*.row, u64)]&;
}

// Write e's T. Returns 0 if e is dead or has no T. Checked: it is kayan_get
// and a test, which is what every caller of kayan_get has to write anyway.
kayan_set: proc<T>(w: *kayan_world, e: kayan_entity, value: T) -> b32 = {
    p: ?*T = kayan_get<T>(w, e);
    if (!p) {
        return 0;
    }
    p* = value;
    return 1;
}

// e's component `id` as its bytes, or an empty slice if e is dead or has no
// such component. For tools that work from reflection records rather than from
// types, like lesson 5's inspector. Trusted: a slice over raw column bytes.
kayan_get_bytes: proc[trusted](w: *const kayan_world, e: kayan_entity, id: u32) -> []u8 = {
    none: []u8 = {};
    if (!kayan_alive(w, e) || id >= w*.component_count) {
        return none;
    }
    slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
    t: *kayan_table = kayan_table_at(w, slot*.table);
    if (t*.columns[id] == null) {
        return none;
    }
    size: u64 = kayan_info(w, id)*.size;
    column: []u8 = t*.columns[id][0..t*.count * size];
    row: u64 = cast(slot*.row, u64);
    return column[row * size..(row + 1) * size];
}

// Give e a T, moving it to a new table if it did not have one. Checked: it is
// written in terms of move and set.
kayan_add: proc<T>(w: *kayan_world, e: kayan_entity, value: T) -> kayan_status = {
    if (kayan_move(w, e, kayan_signature(w, e) | kayan_mask_of<T>()) == kayan_status.dead) {
        return kayan_status.dead;
    }
    _ = kayan_set<T>(w, e, value);
    return kayan_status.ok;
}

// Take e's T away, moving it to the table without it.
kayan_remove: proc<T>(w: *kayan_world, e: kayan_entity) -> kayan_status = {
    return kayan_move(w, e, kayan_signature(w, e) & ~kayan_mask_of<T>());
}

// Every row of every table must belong to a live entity whose slot points back
// at that table and row, and the rows must add up to the live count. Returns
// how many of those checks failed, printing each.
kayan_verify: proc(w: *const kayan_world) -> u64 = {
    problems: u64 = 0;
    rows: u64 = 0;
    for (ti: u64 = 0; ti < w*.tables*.length; ti += 1) {
        t: *kayan_table = vec<kayan_table>at(w*.tables, ti);
        ids: []kayan_entity = kayan_table_entities(t);
        for (row: u64 = 0; row < ids.length; row += 1) {
            e: kayan_entity = ids[row];
            if (!kayan_alive(w, e)) {
                printfmt("kayan_verify: table {} row {} holds dead entity {}:{}\n",
                    ti, row, e.index, e.generation);
                problems += 1;
                continue;
            }
            slot: *kayan_slot = vec<kayan_slot>at(w*.slots, cast(e.index, u64));
            if (cast(slot*.table, u64) != ti || cast(slot*.row, u64) != row) {
                printfmt("kayan_verify: {}:{} is in table {} row {}, its slot says table {} row {}\n",
                    e.index, e.generation, ti, row, slot*.table, slot*.row);
                problems += 1;
            }
        }
        rows += t*.count;
    }
    if (rows != w*.live) {
        printfmt("kayan_verify: {} rows in tables, {} entities alive\n", rows, w*.live);
        problems += 1;
    }
    return problems;
}

// ---------------------------------------------------------------------------
// Printing
// ---------------------------------------------------------------------------

// Trusted for the `*const` promise only: it prints. A checked proc taking the
// world would be assumed able to move tables, and a caller walking them would
// have to take its pointers again after every call.
kayan_print_signature: proc(w: *const kayan_world, signature: u64) -> void = {
    printfmt("{");
    first: b32 = 1;
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if ((signature & kayan_bit(id)) != 0) {
            if (!first) {
                printfmt(" ");
            }
            printfmt("{}", kayan_component_name(w, id));
            first = 0;
        }
    }
    printfmt("}");
}

kayan_print_tables: proc(w: *const kayan_world) -> void = {
    for (ti: u64 = 0; ti < w*.tables*.length; ti += 1) {
        t: *kayan_table = vec<kayan_table>at(w*.tables, ti);
        printfmt("    table {} ", cast(ti, i32));
        kayan_print_signature(w, t*.signature);
        printfmt(":");
        ids: []kayan_entity = kayan_table_entities(t);
        for (row: u64 = 0; row < ids.length; row += 1) {
            e: kayan_entity = ids[row];
            printfmt(" {}:{}", e.index, e.generation);
        }
        printfmt("\n");
    }
}
