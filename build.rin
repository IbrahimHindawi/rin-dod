// How the lessons are built. Read by `rin build`, not executed.
//
// Every lesson is its own program, named after its file. tools/check.py reads
// this same list, builds each lesson, runs it and compares its output with the
// .expected file beside it.
build_name:      ^const char = "rin-dod";
build_dir:       ^const char = "build";
build_generator: ^const char = "Ninja";
build_compiler:  ^const char = "clang-cl";
build_type:      ^const char = "Debug";

// std's string8 calls fopen, which the Windows SDK marks deprecated.
build_defines: [_]^const char = { "_CRT_SECURE_NO_WARNINGS" };

build_entries: [_]^const char = {
    // Build an ECS: start here, README.md
    "ecs/src/1.entities/1.1.ids/ids.rin",
    "ecs/src/1.entities/1.2.despawn/despawn.rin",
    "ecs/src/1.entities/1.3.generations/generations.rin",
    "ecs/src/1.entities/1.4.entity_index/entity_index.rin",
    // The same four, written in rin's safe subset: ecs/safe/README.md
    "ecs/safe/1.entities/1.1.ids/ids.rin",
    "ecs/safe/1.entities/1.2.despawn/despawn.rin",
    "ecs/safe/1.entities/1.3.generations/generations.rin",
    "ecs/safe/1.entities/1.4.entity_index/entity_index.rin",
    "ecs/safe/2.components/2.1.components/components.rin",
    "ecs/safe/2.components/2.2.columns/columns.rin",
    "ecs/safe/2.components/2.3.tables/tables.rin",
    "ecs/safe/2.components/2.4.archetypes/archetypes.rin",
    "ecs/safe/2.components/2.5.typed_access/typed_access.rin",
    "ecs/safe/2.components/2.6.add_remove/add_remove.rin",
    "ecs/safe/2.components/2.7.inspecting/inspecting.rin",
    "ecs/safe/3.systems/3.1.queries/queries.rin",
    "ecs/safe/3.systems/3.2.systems/systems.rin",
    "ecs/safe/3.systems/3.3.commands/commands.rin",
    "ecs/safe/3.systems/3.4.game/game.rin",
    "ecs/src/2.components/2.1.components/components.rin",
    "ecs/src/2.components/2.2.columns/columns.rin",
    "ecs/src/2.components/2.3.tables/tables.rin",
    "ecs/src/2.components/2.4.archetypes/archetypes.rin",
    "ecs/src/2.components/2.5.typed_access/typed_access.rin",
    "ecs/src/2.components/2.6.add_remove/add_remove.rin",
    "ecs/src/2.components/2.7.inspecting/inspecting.rin",
    "ecs/src/3.systems/3.1.queries/queries.rin",
    "ecs/src/3.systems/3.2.systems/systems.rin",
    "ecs/src/3.systems/3.3.commands/commands.rin",
    "ecs/src/3.systems/3.4.game/game.rin",

    // Advanced: layout and SIMD, docs/README.md
    "src/1.aos_vs_soa/aos_vs_soa.rin",
    "src/2.archetype_table/archetype_table.rin",
    "src/3.many_archetypes/many_archetypes.rin",
    "src/4.entity_handles/entity_handles.rin",
    "src/5.inspector/inspector.rin",
    "src/6.kayan/kayan.rin",
    "src/7.access_patterns/access_patterns.rin",
    // The same seven in the safe subset: src/safe
    "src/safe/1.aos_vs_soa/aos_vs_soa.rin",
    "src/safe/2.archetype_table/archetype_table.rin",
    "src/safe/3.many_archetypes/many_archetypes.rin",
    "src/safe/4.entity_handles/entity_handles.rin",
    "src/safe/5.inspector/inspector.rin",
    "src/safe/6.kayan/kayan.rin",
    "src/safe/7.access_patterns/access_patterns.rin",

    // The dojo's playgrounds, dojo/README.md
    "dojo/1.free_list/play_free_list.rin",
    "dojo/2.swap_remove/play_swap_remove.rin",
    "dojo/3.slot_map/play_slot_map.rin",
    "dojo/4.column/play_column.rin",
    "dojo/5.commands/play_commands.rin",
    "dojo/6.bitset/play_bitset.rin",
    "dojo/7.arena/play_arena.rin",
    "dojo/8.index/play_index.rin",
    "dojo/9.interning/play_interning.rin",
    "dojo/10.edges/play_edges.rin",
    "dojo/11.reflect/play_reflect.rin",
    "dojo/12.watermark/play_watermark.rin",
    "dojo/13.dispatch/play_dispatch.rin",
    // The dojo's playgrounds in the safe subset: dojo/safe
    "dojo/safe/1.free_list/play_free_list.rin",
    "dojo/safe/2.swap_remove/play_swap_remove.rin",
    "dojo/safe/3.slot_map/play_slot_map.rin",
    "dojo/safe/4.column/play_column.rin",
    "dojo/safe/5.commands/play_commands.rin",
    "dojo/safe/6.bitset/play_bitset.rin",
    "dojo/safe/7.arena/play_arena.rin",
    "dojo/safe/8.index/play_index.rin",
    "dojo/safe/9.interning/play_interning.rin",
    "dojo/safe/10.edges/play_edges.rin",
    "dojo/safe/11.reflect/play_reflect.rin",
    "dojo/safe/12.watermark/play_watermark.rin",
    "dojo/safe/13.dispatch/play_dispatch.rin",
};
