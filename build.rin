// How the lessons are built. Read by `rin build`, not executed.
//
// Every lesson is its own program, named after its file. tools/check.py reads
// this same list, builds each lesson, runs it and compares its output with the
// .expected file beside it.
build_name:      ^const char = "rin-dod";
build_dir:       ^const char = "build";
build_generator: ^const char = "Ninja";
build_compiler:  ^const char = "clang-cl";
build_type:      ^const char = "Debug";

// std's string8 calls fopen, which the Windows SDK marks deprecated.
build_defines: [_]^const char = { "_CRT_SECURE_NO_WARNINGS" };

build_entries: [_]^const char = {
    // Build an ECS: start here, README.md
    "ecs/src/1.entities/1.1.ids/ids.rin",
    "ecs/src/1.entities/1.2.despawn/despawn.rin",
    "ecs/src/1.entities/1.3.generations/generations.rin",
    "ecs/src/1.entities/1.4.entity_index/entity_index.rin",
    "ecs/src/2.components/2.1.components/components.rin",
    "ecs/src/2.components/2.2.columns/columns.rin",
    "ecs/src/2.components/2.3.tables/tables.rin",
    "ecs/src/2.components/2.4.archetypes/archetypes.rin",
    "ecs/src/2.components/2.5.typed_access/typed_access.rin",
    "ecs/src/2.components/2.6.add_remove/add_remove.rin",
    "ecs/src/2.components/2.7.inspecting/inspecting.rin",
    "ecs/src/3.systems/3.1.queries/queries.rin",
    "ecs/src/3.systems/3.2.systems/systems.rin",
    "ecs/src/3.systems/3.3.commands/commands.rin",
    "ecs/src/3.systems/3.4.game/game.rin",

    // Advanced: layout and SIMD, docs/README.md
    "src/1.aos_vs_soa/aos_vs_soa.rin",
    "src/2.archetype_table/archetype_table.rin",
    "src/3.many_archetypes/many_archetypes.rin",
    "src/4.entity_handles/entity_handles.rin",
    "src/5.inspector/inspector.rin",
    "src/6.kayan/kayan.rin",
    "src/7.access_patterns/access_patterns.rin",
};
