// 5. The inspector
//
// Type-erased columns are fast and opaque: to a debugger a column is `^u8`.
// But every component already has a reflect record, registered in lesson 4 so
// the world knew its size. The same record lists the component's fields with
// their names, offsets, sizes and types, and links each struct or enum field to
// a record of its own. That is enough to print any entity, field by field,
// without writing a print proc for any component.
//
// This is where looking things up by name belongs. kayan looked up columns by
// name in every query, once per archetype, to find what to move. Here systems still
// find columns by id, as in lesson 3, and names are only used by tools: this
// inspector, and the editor-style write at the end that sets a field from its
// component and field names.
//
// Fields can carry tags with `@`. The inspector skips anything tagged "hidden",
// which is how a component keeps bookkeeping out of a tool without the tool
// knowing that component exists.
//
// Safe subset: reading a field's bytes as an f32, a u32 or an i32, writing an
// f32 into them, and copying a C string into a fixed array are the four
// trusted procs of this lesson; each checks the length it is given. The walk
// over the reflect records is checked: `reflect_field_at` and
// `reflect_field_info` return `?*const`, since a record can run out of fields
// and a builtin has no record of its own.

import "../../../includes/safe/kayan.rin"

vec2: struct = {
    x: f32;
    y: f32;
}

side: enum = {
    red,
    blue,
}

component: enum = {
    position,
    health,
    team,
    weapon,
    label,
}

position: struct = { at: vec2; heading: f32; }
health: struct = { points: f32; max: f32; regen_timer: f32 @ "hidden"; }
team: struct = { side: side; }
weapon: struct = { damage: f32; cooldown: f32; ammo: u32; }
label: struct = { text: [16]c8; }

component_of: proc<position>() -> component = { return component.position; }
component_of: proc<health>() -> component = { return component.health; }
component_of: proc<team>() -> component = { return component.team; }
component_of: proc<weapon>() -> component = { return component.weapon; }
component_of: proc<label>() -> component = { return component.label; }

register_components: proc(w: *kayan_world) -> void = {
    kayan_register(w, kayan_id_of<position>(), position<>&);
    kayan_register(w, kayan_id_of<health>(), health<>&);
    kayan_register(w, kayan_id_of<team>(), team<>&);
    kayan_register(w, kayan_id_of<weapon>(), weapon<>&);
    kayan_register(w, kayan_id_of<label>(), label<>&);
}

indent: proc(depth: u32) -> void = {
    for (i: u32 = 0; i < depth; i += 1) {
        printfmt("    ");
    }
}

// Trusted for the `*const` promise: a checked proc taking a pointer to a
// record would be assumed able to change what it points at, and the caller's
// other pointers into the same record would be dead after the call.
is_type: proc[trusted](field: *const reflect_field, name: ^const char) -> b32 = {
    return reflect_cstr_equal(field*.type, name);
}

// std's reflect_field_is_array is a checked proc, so the same applies to it;
// this is its body, promised not to move anything.
is_array: proc[trusted](field: *const reflect_field) -> b32 = {
    return field*.kind == reflect_field_kind_array || field*.array_count > 0;
}

// The trusted core: bytes read as a builtin, or written as one. The C types
// behind the names are fixed by rin, so reading through a pointer of the right
// width is exact; each checks that the bytes are at least that wide.
bytes_as_f32: proc[trusted](at: []const u8) -> f32 = {
    if (at.length < sizeof(f32)) { printfmt("inspector: too few bytes for an f32\n"); exit(1); }
    return cast(at[0]&, *const f32)*;
}
bytes_as_u32: proc[trusted](at: []const u8) -> u32 = {
    if (at.length < sizeof(u32)) { printfmt("inspector: too few bytes for a u32\n"); exit(1); }
    return cast(at[0]&, *const u32)*;
}
bytes_as_i32: proc[trusted](at: []const u8) -> i32 = {
    if (at.length < sizeof(i32)) { printfmt("inspector: too few bytes for an i32\n"); exit(1); }
    return cast(at[0]&, *const i32)*;
}
bytes_set_f32: proc[trusted](at: []u8, value: f32) -> void = {
    if (at.length < sizeof(f32)) { printfmt("inspector: too few bytes for an f32\n"); exit(1); }
    cast(at[0]&, *f32)* = value;
}
// Up to `at.length` bytes of text, printed as they are: a [N]c8 field.
print_text: proc[trusted](at: []const u8) -> void = {
    printf("%.*s", cast(at.length, i32), cast(at.data, ^const c8));
}
// A C string into a fixed array: up to dst.length - 1 characters, the rest
// zero, so a shorter label does not keep the tail of a longer one.
cstr_into: proc[trusted](dst: []c8, text: ^const c8) -> void = {
    for (i: u64 = 0; i < dst.length; i += 1) { dst[i] = 0; }
    for (i: u64 = 0; i + 1 < dst.length && text[i] != 0; i += 1) {
        dst[i] = text[i];
    }
}

// One value of a builtin type.
print_builtin: proc(type_name: ^const char, at: []const u8) -> void = {
    if (reflect_cstr_equal(type_name, "f32")) {
        printfmt("{:.2}", cast(bytes_as_f32(at), f64));
    } else if (reflect_cstr_equal(type_name, "u32")) {
        printfmt("{}", bytes_as_u32(at));
    } else if (reflect_cstr_equal(type_name, "i32")) {
        printfmt("{}", bytes_as_i32(at));
    } else {
        printfmt("<{}>", type_name);
    }
}

// Every field of a struct whose bytes are `base`, recursing into struct
// fields. Enum fields print their member name; a [N]c8 prints as text. Each
// field's bytes are cut from `base` by its offset and size, so a record that
// disagreed with the data would stop the program in Debug.
print_fields: proc(type: *const reflect, base: []const u8, depth: u32) -> void = {
    for (i: u64 = 0; i < type*.count; i += 1) {
        f: ?*const reflect_field = reflect_field_at(type, i);
        if (!f || reflect_field_has_attr(f, "hidden")) {
            continue;
        }
        at: []const u8 = base[f*.offset..f*.offset + f*.size];
        indent(depth);
        printfmt("{}:", f*.name);
        info: ?*const reflect = reflect_field_info(f);
        if (is_array(f) && reflect_cstr_equal(f*.elem_type, "c8")) {
            printfmt(" \"");
            print_text(at);
            printfmt("\"\n");
        } else if (info && info*.kind == reflect_kind_struct) {
            printfmt("\n");
            print_fields(info, at, depth + 1);
        } else if (info && info*.kind == reflect_kind_enum) {
            value: i32 = bytes_as_i32(at);
            printfmt(" {}\n", reflect_name_from_value_or(info, value, "(not a member)"));
        } else {
            printfmt(" ");
            print_builtin(f*.type, at);
            printfmt("\n");
        }
    }
}

inspect: proc(w: *kayan_world, name: ^const char, e: kayan_entity) -> void = {
    printfmt("{} ({}:{})\n", name, e.index, e.generation);
    signature: u64 = kayan_signature(w, e);
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        if ((signature & kayan_bit(id)) != 0) {
            info: *const reflect in permanent = kayan_info(w, id);
            printfmt("    {}\n", info*.name);
            // A local first: widening a call's []u8 to []const u8 reads it twice.
            bytes: []u8 = kayan_get_bytes(w, e, id);
            print_fields(info, bytes, 2);
        }
    }
}

// What each table holds: per component, its size, and its column's bytes in use
// out of the bytes allocated for the table's capacity.
print_layout: proc(w: *kayan_world) -> void = {
    for (ti: u64 = 0; ti < w*.tables*.length; ti += 1) {
        t: *kayan_table = vec<kayan_table>at(w*.tables, ti);
        printfmt("table {} ", cast(ti, i32));
        kayan_print_signature(w, t*.signature);
        printfmt(", rows in use: {} of {}\n", cast(t*.count, i32), cast(t*.capacity, i32));
        for (id: u32 = 0; id < w*.component_count; id += 1) {
            if (t*.columns[id] != null) {
                info: *const reflect in permanent = kayan_info(w, id);
                printfmt("    {:-8} {:2} bytes, align {}, column {} of {} bytes\n", info*.name,
                    cast(info*.size, i32), cast(info*.align, i32),
                    cast(info*.size * t*.count, i32), cast(info*.size * t*.capacity, i32));
            }
        }
    }
}

// The editor's write: set an f32 field by component and field name. Slow and
// flexible, which is right for a tool and wrong for a system.
set_f32_by_name: proc(w: *kayan_world, e: kayan_entity, component_name: ^const char,
                      field_name: ^const char, value: f32) -> b32 = {
    for (id: u32 = 0; id < w*.component_count; id += 1) {
        info: *const reflect in permanent = kayan_info(w, id);
        if (!reflect_cstr_equal(info*.name, component_name)) {
            continue;
        }
        bytes: []u8 = kayan_get_bytes(w, e, id);
        f: ?*const reflect_field = reflect_find_field(info, field_name);
        if (bytes.length == 0 || !f || !is_type(f, "f32")) {
            return 0;
        }
        bytes_set_f32(bytes[f*.offset..f*.offset + f*.size], value);
        return 1;
    }
    return 0;
}

// Up to 15 characters, the rest of the array zeroed, so a shorter label does
// not keep the tail of a longer one.
set_label: proc(w: *kayan_world, e: kayan_entity, text: ^const c8) -> void = {
    l: ?*label = kayan_get<label>(w, e);
    if (!l) {
        return;
    }
    cstr_into(l*.text, text);
}

main: proc() -> i32 = {
    level: region = {
    world: *kayan_world in level = kayan_world_make(level);
    register_components(world);

    soldier: kayan_entity = kayan_spawn(world, kayan_mask_of<position>() | kayan_mask_of<health>()
        | kayan_mask_of<team>() | kayan_mask_of<weapon>() | kayan_mask_of<label>());
    _ = kayan_set<position>(world, soldier, { .at = { .x = 3.0, .y = 4.0 }, .heading = 90.0 });
    _ = kayan_set<health>(world, soldier, { .points = 80.0, .max = 100.0, .regen_timer = 2.5 });
    _ = kayan_set<team>(world, soldier, { .side = side.blue });
    _ = kayan_set<weapon>(world, soldier, { .damage = 12.5, .cooldown = 0.25, .ammo = 30 });
    set_label(world, soldier, "soldier");

    crate: kayan_entity = kayan_spawn(world, kayan_mask_of<position>() | kayan_mask_of<label>());
    _ = kayan_set<position>(world, crate, { .at = { .x = -1.0, .y = 0.5 } });
    set_label(world, crate, "crate");

    inspect(world, "soldier", soldier);
    inspect(world, "crate", crate);

    printfmt("\nthe editor writes three fields by name\n");
    printfmt("    soldier health.points = 55: {}\n",
        set_f32_by_name(world, soldier, "health", "points", 55.0) ? "written" : "refused");
    printfmt("    soldier weapon.ammo = 1: {}, ammo is a u32, not an f32\n",
        set_f32_by_name(world, soldier, "weapon", "ammo", 1.0) ? "written" : "refused");
    printfmt("    crate health.points = 1: {}, the crate has no health\n",
        set_f32_by_name(world, crate, "health", "points", 1.0) ? "written" : "refused");
    inspect(world, "soldier", soldier);

    printfmt("\n");
    print_layout(world);
    }
    return 0;
}
